# Copy to .env and fill in. Never commit .env: it holds the bot token.

# Bot token from @BotFather (/newbot)
TELEGRAM_TOKEN=
# Chat that receives the measurements: docker compose run --rm scale-bot find-chat
TELEGRAM_CHAT_ID=
# MAC address of your scale (empty = any scale speaking this protocol)
SCALE_MAC=
# Time zone for the times in the messages
TZ=Europe/Rome
